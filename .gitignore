# Réglages Xcode propres à un utilisateur (thème de l'éditeur, points d'arrêt,
# ordre des schémas…). Ils n'ont pas leur place dans le dépôt : ils changent
# tout seuls au fil de l'utilisation et ne concernent que la machine locale.
# Les schémas partagés, eux, vivent dans xcshareddata et restent versionnés.
xcuserdata/

# Produits de compilation
build/
DerivedData/

# Finder
.DS_Store

# Images de travail / d'essai posées dans le dossier du projet. Git conserve
# chaque version de chaque binaire : versionner des photos ferait grossir le
# dépôt de façon irréversible, pour des fichiers qui ne sont pas du code.
Images exportées/

# Modèle CLIP (Core ML) — voir PierreVincent/ModeleCLIP/README.md : licence
# recherche uniquement, et 23 Mo de poids qui n'ont pas leur place dans
# l'historique Git. Le script telecharger.sh le récupère à la demande.
PierreVincent/ModeleCLIP/mobileclip_s0_image.mlpackage/
